# FeedSignal owner preparation. See ../../UNANSWERED_SECRETS.md.
# UNANSWERED_DATABASE_URL — resolve privately or confirm public origin; local defaults are development only.
DATABASE_URL=postgresql://user@localhost/customer_feedback_saas
# UNANSWERED_JWT_SECRET — resolve privately or confirm public origin; local defaults are development only.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# Fernet key that encrypts stored integration secrets incl. the OIDC client_secret.
# Without it, saving SSO/integration config returns 422. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# UNANSWERED_LLM_ENCRYPTION_KEY — resolve privately or confirm public origin; local defaults are development only.
LLM_ENCRYPTION_KEY=

# Slack OAuth
# UNANSWERED_SLACK_CLIENT_ID — resolve privately or confirm public origin; local defaults are development only.
SLACK_CLIENT_ID=
# UNANSWERED_SLACK_CLIENT_SECRET — resolve privately or confirm public origin; local defaults are development only.
SLACK_CLIENT_SECRET=
# UNANSWERED_SLACK_REDIRECT_URI — resolve privately or confirm public origin; local defaults are development only.
SLACK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/slack/oauth/callback
# Also sets the SSO post-login redirect base (OIDC callback sends the browser here).
# UNANSWERED_APP_ORIGIN — resolve privately or confirm public origin; local defaults are development only.
FRONTEND_URL=http://localhost:3000

# Intercom OAuth
# UNANSWERED_INTERCOM_CLIENT_ID — resolve privately or confirm public origin; local defaults are development only.
INTERCOM_CLIENT_ID=
# UNANSWERED_INTERCOM_CLIENT_SECRET — resolve privately or confirm public origin; local defaults are development only.
INTERCOM_CLIENT_SECRET=
# UNANSWERED_INTERCOM_REDIRECT_URI — resolve privately or confirm public origin; local defaults are development only.
INTERCOM_REDIRECT_URI=http://localhost:8000/api/v1/integrations/intercom/oauth/callback

# Linear OAuth
# UNANSWERED_LINEAR_CLIENT_ID — resolve privately or confirm public origin; local defaults are development only.
LINEAR_CLIENT_ID=
# UNANSWERED_LINEAR_CLIENT_SECRET — resolve privately or confirm public origin; local defaults are development only.
LINEAR_CLIENT_SECRET=
# UNANSWERED_LINEAR_REDIRECT_URI — resolve privately or confirm public origin; local defaults are development only.
LINEAR_REDIRECT_URI=http://localhost:8000/api/v1/integrations/linear/callback
# Also sets the OIDC callback base: {BACKEND_URL}/api/v1/auth/oidc/callback (whitelist this with your IdP).
# SAML SSO (saml-sso): ACS/callback base is {BACKEND_URL}/api/v1/auth/saml/callback (register this as the
# SP Assertion Consumer Service URL with your IdP). SAML IdP config (Entity ID, SSO URL, X.509 cert) is
# DB-stored per-org like OIDC — no new env var in slice 1 (unsigned AuthnRequest, no SP private key).
# UNANSWERED_API_ORIGIN — resolve privately or confirm public origin; local defaults are development only.
BACKEND_URL=http://localhost:8000

# Billing: none. The open-source self-hosted edition has no Stripe integration and
# no plan gating — every feature is unlocked. SELF_HOSTED defaults to true; set it
# to false only if you are deliberately running the tiered hosted mode.
# SELF_HOSTED=true

# Email (Resend)
# UNANSWERED_RESEND_API_KEY — resolve privately or confirm public origin; local defaults are development only.
RESEND_API_KEY=
# UNANSWERED_RESEND_FROM_EMAIL — resolve privately or confirm public origin; local defaults are development only.
FROM_EMAIL=
FROM_NAME=FeedSignal
# UNANSWERED_APP_ORIGIN — resolve privately or confirm public origin; local defaults are development only.
APP_URL=http://localhost:3000
# Template IDs - run: python -m src.scripts.setup_email_templates --create
RESEND_TEMPLATE_TEAM_INVITE=
RESEND_TEMPLATE_WELCOME=
RESEND_TEMPLATE_ALERT_NOTIFICATION=

# Email Inbound (Resend Webhooks)
# UNANSWERED_RESEND_INBOUND_WEBHOOK_SECRET — resolve privately or confirm public origin; local defaults are development only.
RESEND_INBOUND_WEBHOOK_SECRET=

# Super Admin
SUPER_ADMIN_EMAIL=aayaannkausar@gmail.com

ADMIN_EMAIL=aayaannkausar@gmail.com
# UNANSWERED_ADMIN_PASSWORD
ADMIN_PASSWORD=
# UNANSWERED_SLACK_SIGNING_SECRET
SLACK_SIGNING_SECRET=
# UNANSWERED_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
# UNANSWERED_SALESFORCE_CLIENT_ID
SALESFORCE_CLIENT_ID=
# UNANSWERED_SALESFORCE_CLIENT_SECRET
SALESFORCE_CLIENT_SECRET=
# UNANSWERED_SALESFORCE_REDIRECT_URI (set exact public callback when configured).
SALESFORCE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/salesforce/callback
# UNANSWERED_RESEND_TEMPLATE_IDS: optional owner-account templates only.
