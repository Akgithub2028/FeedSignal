# FeedSignal frontend preparation; public settings only.
# UNANSWERED_API_ORIGIN: localhost is a development default, not your production API.
NEXT_PUBLIC_API_URL=http://localhost:8000
# UNANSWERED_APP_ORIGIN: leave unset until an owned public app origin is known.
NEXT_PUBLIC_APP_URL=
# UNANSWERED_GOOGLE_CLIENT_ID: public Google web client ID (never a client secret).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# UNANSWERED_SENTRY_CONFIGURATION: optional browser DSN; leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
# Billing endpoints were removed from the baseline. A Stripe key alone does not
# restore SaaS subscriptions; managed billing is a separate M1 implementation.
