# Redis Configuration (single instance with logical DBs)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Celery uses DB 0 for broker and backend
CELERY_BROKER_DB=0
CELERY_BACKEND_DB=0

# Database (same as backend-api)
DATABASE_URL=postgresql://localhost/customer_feedback_saas

# Analysis engine path
ANALYSIS_ENGINE_PATH=../analysis-engine/src

# Task configuration
ANALYSIS_BATCH_SIZE=100
ANALYSIS_TIMEOUT=600

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY=60

# FeedSignal owner preparation. Backend and worker must share database/encryption settings.
# UNANSWERED_DATABASE_URL -> DATABASE_URL (local value above is not a hosted connection).
# UNANSWERED_REDIS_HOST / UNANSWERED_REDIS_PASSWORD -> REDIS_HOST / REDIS_PASSWORD.
# UNANSWERED_LLM_ENCRYPTION_KEY
LLM_ENCRYPTION_KEY=
FROM_NAME=FeedSignal
# UNANSWERED_RESEND_FROM_EMAIL
FROM_EMAIL=
# UNANSWERED_RESEND_API_KEY
RESEND_API_KEY=
# UNANSWERED_APP_ORIGIN: development default only.
APP_URL=http://localhost:3000
# UNANSWERED_SALESFORCE_CLIENT_ID
SALESFORCE_CLIENT_ID=
# UNANSWERED_SALESFORCE_CLIENT_SECRET
SALESFORCE_CLIENT_SECRET=
