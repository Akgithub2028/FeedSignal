# =============================================================================
# FeedSignal — Production / Self-Host Environment Template
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values, then run:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# All features are unlocked on self-hosted instances (SELF_HOSTED=true).
# By default the product runs $0 on the free local VADER pipeline with NO
# LLM key required. Add your own key only if you want LLM-powered analysis.
# =============================================================================

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
# Full connection string used by backend + worker.
# When using the bundled compose, this points at the `postgres` service.
# UNANSWERED_DATABASE_URL: direct-service URL goes in a private runtime file.
# Compose constructs its database URL from POSTGRES_* below.
DATABASE_URL=

# Credentials the bundled `postgres` container is created with.
# Keep these in sync with DATABASE_URL above.
POSTGRES_USER=rereflect
POSTGRES_PASSWORD=
POSTGRES_DB=rereflect

# ----------------------------------------------------------------------------
# Security / Secrets  (REQUIRED — generate fresh random values)
# ----------------------------------------------------------------------------
# Signs auth (JWT) tokens. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Fernet key used to encrypt BYOK LLM API keys at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# First admin user (seeded on first startup)
# ----------------------------------------------------------------------------
ADMIN_EMAIL=aayaannkausar@gmail.com
ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# Networking
# ----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000

# Public URL of the backend API. NOTE: the frontend BAKES this in at build time
# (see docker-compose.prod.yml). If you change it for a real host, you must
# REBUILD the frontend image:
#   docker compose -f docker-compose.prod.yml build frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# Self-host flag — keep `true` to unlock all features with no limits.
# (Only set to `false` if you intend to run a gated/hosted multi-tenant tier.)
# ----------------------------------------------------------------------------
SELF_HOSTED=true

# ----------------------------------------------------------------------------
# AI analysis
# ----------------------------------------------------------------------------
# Default `false`: a fresh install runs entirely on the free local VADER +
# keyword pipeline ($0, no key required). Set `true` only after configuring an
# LLM key (below) to enable LLM-powered categorization, insights, and copilot.
ai_analysis_enabled=false

# ----------------------------------------------------------------------------
# OPTIONAL — Bring Your Own Key (BYOK)
# ----------------------------------------------------------------------------
# These are YOUR OWN keys for YOUR OWN single-tenant instance. Rereflect never
# provides, proxies, or pays for a key — there is no system/vendor key.
#
# The canonical place to add a key is the in-app UI (Settings -> AI), which
# stores it encrypted per organization. The env vars below are a convenience
# for single-tenant operators who prefer to seed a key from the environment.
# Leave them blank to run on the free VADER pipeline.
#
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=

# ----------------------------------------------------------------------------
# OPTIONAL — Error tracking (Sentry). OFF by default.
# ----------------------------------------------------------------------------
# Rereflect sends NO telemetry, crash reports, or usage data anywhere unless
# you explicitly set SENTRY_DSN below. Leave it unset/empty and the SDK is
# never initialized — your instance makes no outbound calls of its own.
#
# If you DO want error tracking, point this at YOUR OWN Sentry project.
# PII is not sent (send_default_pii=False).
#
# Covers the backend, the Celery worker, and the Next.js server runtime:
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
#
# Browser-side reporting is separate and BAKED IN AT BUILD TIME — if you set it,
# you must rebuild the frontend image:
#   docker compose -f docker-compose.prod.yml build frontend
# NEXT_PUBLIC_SENTRY_DSN=

# ----------------------------------------------------------------------------
# OPTIONAL — Intercom integration (webhook-only feedback source)
# ----------------------------------------------------------------------------
# To connect Intercom as a feedback source, register an app in the Intercom
# Developer Hub and set the following. The CLIENT_SECRET also serves as the
# webhook HMAC key and is required if the webhook endpoint is exposed.
# See docs/SELF_HOSTING.md for full setup instructions.
#
# The redirect URI must exactly match the one registered on your Intercom app.
# It defaults to localhost in code, which is wrong for a deployed instance — set
# it to your real backend origin here.
#
# INTERCOM_CLIENT_ID=
# INTERCOM_CLIENT_SECRET=
# INTERCOM_REDIRECT_URI=https://api.your-domain.com/api/v1/integrations/intercom/oauth/callback

# --- Inbound webhook signing secrets -----------------------------------------
# Every inbound webhook endpoint authenticates deliveries with an HMAC signature
# keyed on one of these. On a production instance, set the secret for every
# source you use — an unset secret is the difference between "only your provider
# can post here" and "anyone who knows the URL can".
#
# INTERCOM_CLIENT_SECRET (above) is also the Intercom webhook HMAC key.
#   Unset -> deliveries REJECTED with 401 (fails closed).
#
# SLACK_SIGNING_SECRET — Slack app -> Basic Information -> Signing Secret.
#   Unset -> every Slack webhook delivery is REJECTED (401). Fails closed.
# SLACK_SIGNING_SECRET=
#
# RESEND_INBOUND_WEBHOOK_SECRET — Resend -> inbound webhook settings.
#   Unset -> every inbound email webhook delivery is REJECTED (401). Fails closed.
# RESEND_INBOUND_WEBHOOK_SECRET=

# FeedSignal owner preparation; see UNANSWERED_SECRETS.md.
# Required values are empty intentionally. Do not deploy this template unchanged.
# UNANSWERED_POSTGRES_PASSWORD -> POSTGRES_PASSWORD (private value).
# UNANSWERED_JWT_SECRET -> JWT_SECRET (private value).
# UNANSWERED_LLM_ENCRYPTION_KEY -> LLM_ENCRYPTION_KEY (preserve/migrate existing DB keys).
# UNANSWERED_ADMIN_PASSWORD -> ADMIN_PASSWORD (private value).
SUPER_ADMIN_EMAIL=aayaannkausar@gmail.com
FROM_NAME=FeedSignal
# UNANSWERED_RESEND_FROM_EMAIL -> FROM_EMAIL (verified sender; support Gmail is not a verified sending domain).
# FROM_EMAIL=
# UNANSWERED_APP_ORIGIN -> FRONTEND_URL, APP_URL and CORS_ORIGINS before production.
# FRONTEND_URL=http://localhost:3000
# APP_URL=http://localhost:3000
# UNANSWERED_API_ORIGIN -> BACKEND_URL and NEXT_PUBLIC_API_URL before production.
# BACKEND_URL=http://localhost:8000
# UNANSWERED_SLACK_CLIENT_ID -> SLACK_CLIENT_ID
# SLACK_CLIENT_ID=
# UNANSWERED_SLACK_CLIENT_SECRET -> SLACK_CLIENT_SECRET
# SLACK_CLIENT_SECRET=
# UNANSWERED_SLACK_REDIRECT_URI -> SLACK_REDIRECT_URI
# SLACK_REDIRECT_URI=
# UNANSWERED_SLACK_SIGNING_SECRET -> SLACK_SIGNING_SECRET
# UNANSWERED_LINEAR_CLIENT_ID -> LINEAR_CLIENT_ID
# LINEAR_CLIENT_ID=
# UNANSWERED_LINEAR_CLIENT_SECRET -> LINEAR_CLIENT_SECRET
# LINEAR_CLIENT_SECRET=
# UNANSWERED_LINEAR_REDIRECT_URI -> LINEAR_REDIRECT_URI
# LINEAR_REDIRECT_URI=
# UNANSWERED_GOOGLE_CLIENT_ID -> GOOGLE_CLIENT_ID / frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_ID=
# UNANSWERED_RESEND_API_KEY -> RESEND_API_KEY (backend and worker).
# RESEND_API_KEY=
# UNANSWERED_RESEND_INBOUND_WEBHOOK_SECRET -> RESEND_INBOUND_WEBHOOK_SECRET
# UNANSWERED_INTERCOM_CLIENT_ID / UNANSWERED_INTERCOM_CLIENT_SECRET / UNANSWERED_INTERCOM_REDIRECT_URI:
# configure the legacy OAuth variables above only when choosing that connection path.
# UNANSWERED_SALESFORCE_CLIENT_ID -> SALESFORCE_CLIENT_ID (backend and worker).
# SALESFORCE_CLIENT_ID=
# UNANSWERED_SALESFORCE_CLIENT_SECRET -> SALESFORCE_CLIENT_SECRET (backend and worker).
# SALESFORCE_CLIENT_SECRET=
# UNANSWERED_SALESFORCE_REDIRECT_URI -> SALESFORCE_REDIRECT_URI (backend).
# SALESFORCE_REDIRECT_URI=
# UNANSWERED_REDIS_PASSWORD -> REDIS_PASSWORD where required by your deployment.
# REDIS_PASSWORD=
# Jira/Zendesk/Asana/HubSpot/Intercom token credentials and Discord/Teams URLs go in
# integration UI settings, not invented environment variables. Their markers are
# in UNANSWERED_SECRETS.md. All connector code remains present.
# IMPORTANT: docker-compose.prod.yml currently forwards only selected variables;
# M1 must add explicit forwarding before these optional settings take effect.
